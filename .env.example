# Copy this file to .env and fill in real values. .env is git-ignored; this file is not.
# Every variable here is read by app/config.py (milestone 1, step 3).

# --- Database (Postgres runs in Docker, milestone 1, step 4) ---
POSTGRES_USER=aaktt
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=aaktt
DATABASE_URL=postgresql+psycopg://aaktt:change-me-locally@localhost:5432/aaktt

# --- LLM (local, via Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:8b
